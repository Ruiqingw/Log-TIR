# Source this file or copy it to configs/openrlhf_day3.env before server runs.

MODEL_NAME_OR_PATH=Qwen/Qwen2.5-Coder-3B-Instruct
SFT_DATA=data/sft/spider_sft_2000.jsonl
SFT_OUTPUT_DIR=checkpoints/qwen2.5-coder-3b-logtir-sft
SFT_MAX_LEN=4096
SFT_BATCH_SIZE=64
SFT_MICRO_BATCH_SIZE=1
SFT_MAX_EPOCHS=1
SFT_LR=5e-6

GRPO_PROMPT_DATA=data/rl/spider_grpo_train_2000.jsonl
GRPO_OUTPUT_DIR=checkpoints/qwen2.5-coder-3b-logtir-grpo
GRPO_CKPT_DIR=checkpoints/qwen2.5-coder-3b-logtir-grpo-ckpt
GRPO_ACTOR_MODEL=checkpoints/qwen2.5-coder-3b-logtir-sft
GRPO_REWARD_FUNC=openrlhf_reward.py
GRPO_GPUS_PER_NODE=1
GRPO_VLLM_ENGINES=1
GRPO_VLLM_TP=1
GRPO_TRAIN_BATCH_SIZE=32
GRPO_ROLLOUT_BATCH_SIZE=32
GRPO_N_SAMPLES_PER_PROMPT=4
GRPO_MAX_EPOCHS=1
GRPO_MAX_SAMPLES=2000
GRPO_MAX_LEN=4096
GRPO_ACTOR_LR=5e-7
GRPO_INIT_KL_COEF=0.01
GRPO_USE_KL_LOSS=1
GRPO_KL_ESTIMATOR=k3
GRPO_EVAL_DATA=data/rl/spider_grpo_dev_100.jsonl
GRPO_EVAL_STEPS=50
RAY_ADDRESS=http://127.0.0.1:8265
