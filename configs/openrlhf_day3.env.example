# Source this file or copy it to configs/openrlhf_day3.env before server runs.

MODEL_NAME_OR_PATH=Qwen/Qwen2.5-Coder-3B-Instruct
SFT_DATA=data/sft/spider_sft_2000.jsonl
SFT_OUTPUT_DIR=checkpoints/qwen2.5-coder-3b-logtir-sft
SFT_MAX_LEN=2048
SFT_BATCH_SIZE=64
SFT_MICRO_BATCH_SIZE=1
SFT_MAX_EPOCHS=1
SFT_LR=5e-6

GRPO_PROMPT_DATA=data/rl/spider_grpo_train_2000.jsonl
GRPO_OUTPUT_DIR=checkpoints/qwen2.5-coder-3b-logtir-grpo
GRPO_CKPT_DIR=checkpoints/qwen2.5-coder-3b-logtir-grpo-ckpt
GRPO_ACTOR_MODEL=checkpoints/qwen2.5-coder-3b-logtir-sft
GRPO_REWARD_FUNC=openrlhf_reward.py
GRPO_AGENT_FUNC=openrlhf_agent.py
GRPO_MULTI_TURN=1
LOGTIR_AGENT_MAX_TURNS=2
LOGTIR_AGENT_TIMEOUT=5.0
LOGTIR_AGENT_TURN_PENALTY=0.05
# 4x4090/3090 style layout: train actor/reference on 3 GPUs and keep 1 GPU for vLLM.
# The colocate-all + vLLM sleep layout is faster in theory, but OOMs during
# vLLM wake-up on 24GB cards.
GRPO_GPUS_PER_NODE=3
GRPO_RAY_NUM_GPUS=4
GRPO_ACTOR_GPUS_PER_NODE=3
GRPO_REF_GPUS_PER_NODE=3
GRPO_VLLM_ENGINES=1
GRPO_VLLM_TP=1
GRPO_VLLM_ENFORCE_EAGER=0
GRPO_VLLM_ENABLE_SLEEP=0
GRPO_VLLM_GPU_MEMORY_UTILIZATION=0.75
GRPO_COLOCATE_ALL=0
GRPO_TRAIN_BATCH_SIZE=6
GRPO_ROLLOUT_BATCH_SIZE=6
GRPO_N_SAMPLES_PER_PROMPT=4
GRPO_DYNAMIC_BATCH_ENABLE=0
GRPO_MAX_EPOCHS=1
GRPO_MAX_SAMPLES=2000
GRPO_MAX_LEN=2048
GRPO_MAX_NEW_TOKENS=512
GRPO_PACKING_SAMPLES=0
GRPO_ADAM_OFFLOAD=1
GRPO_ACTOR_LR=5e-7
GRPO_ACTOR_ENTROPY_COEF=0
GRPO_INIT_KL_COEF=0.01
GRPO_USE_KL_LOSS=1
GRPO_KL_ESTIMATOR=k3
GRPO_EVAL_DATA=data/rl/spider_grpo_dev_100.jsonl
GRPO_EVAL_STEPS=50
RAY_ADDRESS=http://127.0.0.1:8265
GRPO_USE_RAY_JOB=0
LOGTIR_RAY_TMPDIR=/tmp/luyuheng_ray_logtir

LOGTIR_ENABLE_RUN_LOGS=1
LOGTIR_WANDB=1
WANDB_MODE=offline
WANDB_PROJECT=log-tir
